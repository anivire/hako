{
  "id": "valheim",
  "name": "Valheim",
  "description": {
    "ru": "Выделенный сервер Valheim с модами из Thunderstore",
    "en": "Valheim dedicated server with Thunderstore mods"
  },
  "image": "ghcr.io/community-valheim-tools/valheim-server:latest",
  "dataPath": "/config",
  "volumes": [
    {
      "path": "/opt/valheim",
      "folder": ".server"
    }
  ],
  "env": {
    "SERVER_NAME": "{{SERVER_NAME}}",
    "WORLD_NAME": "{{WORLD}}",
    "SERVER_PASS": "{{PASSWORD}}",
    "SERVER_PUBLIC": "{{PUBLIC}}",
    "CROSSPLAY": "{{CROSSPLAY}}",
    "BEPINEX": "true",
    "SERVER_ARGS": "-preset {{PRESET}}{{#COMBAT}} -modifier combat {{COMBAT}}{{/COMBAT}}{{#DEATHPENALTY}} -modifier deathpenalty {{DEATHPENALTY}}{{/DEATHPENALTY}}{{#RESOURCES}} -modifier resources {{RESOURCES}}{{/RESOURCES}}{{#RAIDS}} -modifier raids {{RAIDS}}{{/RAIDS}}{{#PORTALS}} -modifier portals {{PORTALS}}{{/PORTALS}}{{#NOBUILDCOST}} -setkey nobuildcost{{/NOBUILDCOST}}{{#PASSIVEMOBS}} -setkey passivemobs{{/PASSIVEMOBS}}{{#PLAYEREVENTS}} -setkey playerevents{{/PLAYEREVENTS}}{{#NOMAP}} -setkey nomap{{/NOMAP}}{{#FIRE}} -setkey fire{{/FIRE}} -saveinterval {{SAVE_INTERVAL}} -backups {{BACKUPS}} -backupshort {{BACKUP_SHORT}} -backuplong {{BACKUP_LONG}}",
    "TZ": "UTC"
  },
  "ports": [
    {
      "name": "game",
      "container": 2456,
      "protocol": "udp"
    },
    {
      "name": "query",
      "container": 2457,
      "protocol": "udp"
    }
  ],
  "memory": {
    "default": 4096,
    "min": 2048
  },
  "console": {
    "ready": "Game server connected",
    "version": "Valheim version: ?[a-z]*-?(\\d+(?:\\.\\d+)+)"
  },
  "stop": {
    "timeout": 120
  },
  "worlds": {
    "entry": "worlds_local/{{NAME}}.fwl",
    "paths": [
      "worlds_local/{{NAME}}.fwl",
      "worlds_local/{{NAME}}.db",
      "worlds_local/{{NAME}}.fwl.old",
      "worlds_local/{{NAME}}.db.old"
    ],
    "variable": "WORLD"
  },
  "variables": [
    {
      "key": "WORLD",
      "name": {
        "ru": "Мир",
        "en": "World"
      },
      "description": {
        "ru": "Имя файла мира. Если такого мира нет, он создаётся при первом запуске",
        "en": "World file name. A missing world is created on the first start"
      },
      "default": "world",
      "pattern": "^[a-zA-Z0-9_-]{1,32}$",
      "editable": false,
      "group": "world"
    },
    {
      "key": "PRESET",
      "name": {
        "ru": "Пресет мира",
        "en": "World preset"
      },
      "type": "select",
      "default": "normal",
      "options": [
        {
          "value": "casual",
          "label": {
            "ru": "Казуальная",
            "en": "Casual"
          }
        },
        {
          "value": "easy",
          "label": {
            "ru": "Лёгкая",
            "en": "Easy"
          }
        },
        {
          "value": "normal",
          "label": {
            "ru": "Обычная",
            "en": "Normal"
          }
        },
        {
          "value": "hard",
          "label": {
            "ru": "Сложная",
            "en": "Hard"
          }
        },
        {
          "value": "hardcore",
          "label": {
            "ru": "Хардкор",
            "en": "Hardcore"
          }
        },
        {
          "value": "immersive",
          "label": {
            "ru": "Погружение",
            "en": "Immersive"
          }
        },
        {
          "value": "hammer",
          "label": {
            "ru": "Строительство",
            "en": "Hammer"
          }
        }
      ],
      "group": "world",
      "description": {
        "ru": "Готовый набор модификаторов. Модификаторы ниже меняют отдельные настройки поверх него",
        "en": "A ready set of modifiers. The modifiers below change single settings on top of it"
      }
    },
    {
      "key": "COMBAT",
      "name": {
        "ru": "Сражения",
        "en": "Combat"
      },
      "description": {
        "ru": "Урон игроков и врагов, скорость и уровни врагов",
        "en": "Player and enemy damage, enemy speed and levels"
      },
      "type": "select",
      "default": "",
      "options": [
        {
          "value": "",
          "label": {
            "ru": "Как в пресете",
            "en": "As in the preset"
          }
        },
        {
          "value": "veryeasy",
          "label": {
            "ru": "Очень легко",
            "en": "Very easy"
          }
        },
        {
          "value": "easy",
          "label": {
            "ru": "Легко",
            "en": "Easy"
          }
        },
        {
          "value": "hard",
          "label": {
            "ru": "Сложно",
            "en": "Hard"
          }
        },
        {
          "value": "veryhard",
          "label": {
            "ru": "Очень сложно",
            "en": "Very hard"
          }
        }
      ],
      "group": "modifiers"
    },
    {
      "key": "DEATHPENALTY",
      "name": {
        "ru": "Штраф за смерть",
        "en": "Death penalty"
      },
      "description": {
        "ru": "Что теряется при смерти: снаряжение, инвентарь и навыки",
        "en": "What is lost on death: equipment, inventory and skills"
      },
      "type": "select",
      "default": "",
      "options": [
        {
          "value": "",
          "label": {
            "ru": "Как в пресете",
            "en": "As in the preset"
          }
        },
        {
          "value": "casual",
          "label": {
            "ru": "Казуально: снаряжение остаётся",
            "en": "Casual: equipment is kept"
          }
        },
        {
          "value": "veryeasy",
          "label": {
            "ru": "Очень легко",
            "en": "Very easy"
          }
        },
        {
          "value": "easy",
          "label": {
            "ru": "Легко",
            "en": "Easy"
          }
        },
        {
          "value": "hard",
          "label": {
            "ru": "Сложно: инвентарь пропадает",
            "en": "Hard: inventory is destroyed"
          }
        },
        {
          "value": "hardcore",
          "label": {
            "ru": "Хардкор: теряется всё",
            "en": "Hardcore: everything is lost"
          }
        }
      ],
      "group": "modifiers"
    },
    {
      "key": "RESOURCES",
      "name": {
        "ru": "Добыча ресурсов",
        "en": "Resource rate"
      },
      "description": {
        "ru": "Сколько выпадает с мобов и объектов мира",
        "en": "How much drops from mobs and world objects"
      },
      "type": "select",
      "default": "",
      "options": [
        {
          "value": "",
          "label": {
            "ru": "Как в пресете",
            "en": "As in the preset"
          }
        },
        {
          "value": "muchless",
          "label": "×0.5"
        },
        {
          "value": "less",
          "label": "×0.75"
        },
        {
          "value": "more",
          "label": "×1.5"
        },
        {
          "value": "muchmore",
          "label": "×2"
        },
        {
          "value": "most",
          "label": "×3"
        }
      ],
      "group": "modifiers"
    },
    {
      "key": "RAIDS",
      "name": {
        "ru": "Набеги",
        "en": "Raids"
      },
      "description": {
        "ru": "Как часто враги нападают на базу",
        "en": "How often enemies raid your base"
      },
      "type": "select",
      "default": "",
      "options": [
        {
          "value": "",
          "label": {
            "ru": "Как в пресете",
            "en": "As in the preset"
          }
        },
        {
          "value": "none",
          "label": {
            "ru": "Нет",
            "en": "None"
          }
        },
        {
          "value": "muchless",
          "label": {
            "ru": "Намного реже",
            "en": "Much less"
          }
        },
        {
          "value": "less",
          "label": {
            "ru": "Реже",
            "en": "Less"
          }
        },
        {
          "value": "more",
          "label": {
            "ru": "Чаще",
            "en": "More"
          }
        },
        {
          "value": "muchmore",
          "label": {
            "ru": "Намного чаще",
            "en": "Much more"
          }
        }
      ],
      "group": "modifiers"
    },
    {
      "key": "PORTALS",
      "name": {
        "ru": "Порталы",
        "en": "Portals"
      },
      "description": {
        "ru": "Что можно переносить через порталы",
        "en": "What can travel through portals"
      },
      "type": "select",
      "default": "",
      "options": [
        {
          "value": "",
          "label": {
            "ru": "Как в пресете",
            "en": "As in the preset"
          }
        },
        {
          "value": "casual",
          "label": {
            "ru": "Любые предметы",
            "en": "Any items"
          }
        },
        {
          "value": "hard",
          "label": {
            "ru": "Нельзя во время боя с боссом",
            "en": "Not during boss fights"
          }
        },
        {
          "value": "veryhard",
          "label": {
            "ru": "Порталов нет",
            "en": "No portals"
          }
        }
      ],
      "group": "modifiers"
    },
    {
      "key": "NOBUILDCOST",
      "name": {
        "ru": "Строительство без ресурсов",
        "en": "No build cost"
      },
      "description": {
        "ru": "Постройки не требуют материалов, рецепты всё равно нужно открыть",
        "en": "Building needs no materials, recipes still have to be discovered"
      },
      "type": "boolean",
      "default": "false",
      "group": "modifiers"
    },
    {
      "key": "PASSIVEMOBS",
      "name": {
        "ru": "Мирные враги",
        "en": "Passive enemies"
      },
      "description": {
        "ru": "Враги не нападают, пока их не спровоцировать",
        "en": "Enemies do not attack until provoked"
      },
      "type": "boolean",
      "default": "false",
      "group": "modifiers"
    },
    {
      "key": "PLAYEREVENTS",
      "name": {
        "ru": "Набеги по прогрессу игрока",
        "en": "Player based raids"
      },
      "description": {
        "ru": "Набеги зависят от прогресса каждого игрока, а не от убитых на сервере боссов",
        "en": "Raids follow each player’s progress instead of the bosses killed on the server"
      },
      "type": "boolean",
      "default": "false",
      "group": "modifiers"
    },
    {
      "key": "NOMAP",
      "name": {
        "ru": "Без карты",
        "en": "No map"
      },
      "description": {
        "ru": "Карта и миникарта недоступны",
        "en": "The map and minimap are unavailable"
      },
      "type": "boolean",
      "default": "false",
      "group": "modifiers"
    },
    {
      "key": "FIRE",
      "name": {
        "ru": "Пожары",
        "en": "Fire hazards"
      },
      "description": {
        "ru": "Дерево загорается и огонь распространяется по всему миру, а не только в Пепельных землях",
        "en": "Wood catches fire and fire spreads across the whole world, not only in the Ashlands"
      },
      "type": "boolean",
      "default": "false",
      "group": "modifiers"
    },
    {
      "key": "SAVE_INTERVAL",
      "name": {
        "ru": "Автосохранение",
        "en": "Autosave"
      },
      "description": {
        "ru": "Как часто мир сохраняется",
        "en": "How often the world is saved"
      },
      "type": "select",
      "default": "1800",
      "options": [
        {
          "value": "300",
          "label": {
            "ru": "5 мин",
            "en": "5 min"
          }
        },
        {
          "value": "600",
          "label": {
            "ru": "10 мин",
            "en": "10 min"
          }
        },
        {
          "value": "900",
          "label": {
            "ru": "15 мин",
            "en": "15 min"
          }
        },
        {
          "value": "1800",
          "label": {
            "ru": "30 мин",
            "en": "30 min"
          }
        },
        {
          "value": "3600",
          "label": {
            "ru": "1 ч",
            "en": "1 h"
          }
        }
      ],
      "group": "saves"
    },
    {
      "key": "BACKUPS",
      "name": {
        "ru": "Резервных копий",
        "en": "Backups"
      },
      "description": {
        "ru": "Сколько копий мира хранит игра: первая короткая, остальные длинные",
        "en": "How many world backups the game keeps: the first is short, the rest are long"
      },
      "type": "number",
      "default": "4",
      "pattern": "^([0-9]|[1-9][0-9])$",
      "group": "saves",
      "required": true
    },
    {
      "key": "BACKUP_SHORT",
      "name": {
        "ru": "Короткая копия",
        "en": "Short backup"
      },
      "description": {
        "ru": "Через сколько делается первая копия",
        "en": "When the first backup is taken"
      },
      "type": "select",
      "default": "7200",
      "options": [
        {
          "value": "1800",
          "label": {
            "ru": "30 мин",
            "en": "30 min"
          }
        },
        {
          "value": "3600",
          "label": {
            "ru": "1 ч",
            "en": "1 h"
          }
        },
        {
          "value": "7200",
          "label": {
            "ru": "2 ч",
            "en": "2 h"
          }
        },
        {
          "value": "14400",
          "label": {
            "ru": "4 ч",
            "en": "4 h"
          }
        },
        {
          "value": "21600",
          "label": {
            "ru": "6 ч",
            "en": "6 h"
          }
        }
      ],
      "group": "saves"
    },
    {
      "key": "BACKUP_LONG",
      "name": {
        "ru": "Длинные копии",
        "en": "Long backups"
      },
      "description": {
        "ru": "Промежуток между остальными копиями",
        "en": "Time between the other backups"
      },
      "type": "select",
      "default": "43200",
      "options": [
        {
          "value": "7200",
          "label": {
            "ru": "2 ч",
            "en": "2 h"
          }
        },
        {
          "value": "21600",
          "label": {
            "ru": "6 ч",
            "en": "6 h"
          }
        },
        {
          "value": "43200",
          "label": {
            "ru": "12 ч",
            "en": "12 h"
          }
        },
        {
          "value": "86400",
          "label": {
            "ru": "24 ч",
            "en": "24 h"
          }
        }
      ],
      "group": "saves"
    },
    {
      "key": "PASSWORD",
      "name": {
        "ru": "Пароль",
        "en": "Password"
      },
      "description": {
        "ru": "Не короче 5 символов и не должен содержать название сервера",
        "en": "At least 5 characters and must not contain the server name"
      },
      "required": true,
      "pattern": "^\\S{5,64}$",
      "group": "access"
    },
    {
      "key": "PUBLIC",
      "name": {
        "ru": "Показывать в списке серверов",
        "en": "Show in the server list"
      },
      "type": "boolean",
      "default": "true",
      "group": "access"
    },
    {
      "key": "CROSSPLAY",
      "name": {
        "ru": "Кроссплей",
        "en": "Crossplay"
      },
      "description": {
        "ru": "Пускает игроков не из Steam, например с Xbox",
        "en": "Lets non-Steam players in, such as Xbox"
      },
      "type": "boolean",
      "default": "false",
      "group": "access"
    }
  ],
  "groups": [
    {
      "id": "world",
      "name": {
        "ru": "Мир",
        "en": "World"
      },
      "description": {
        "ru": "Сид мира выбирает игра. Чтобы играть в свой мир, загрузите его файлы в worlds_local",
        "en": "The game picks the world seed. To play your own world, upload its files into worlds_local"
      }
    },
    {
      "id": "modifiers",
      "name": {
        "ru": "Модификаторы мира",
        "en": "World modifiers"
      },
      "description": {
        "ru": "Те же настройки, что в игре при создании мира",
        "en": "The same settings the game offers when creating a world"
      },
      "collapsed": true
    },
    {
      "id": "saves",
      "name": {
        "ru": "Сохранения",
        "en": "Saves"
      },
      "collapsed": true
    },
    {
      "id": "access",
      "name": {
        "ru": "Доступ",
        "en": "Access"
      }
    }
  ],
  "icon": "data:image/png;base64,",
  "addons": [
    {
      "source": "thunderstore",
      "params": {
        "community": "valheim",
        "dir": "bepinex/plugins",
        "disabled": "bepinex/disabled",
        "patchers": "bepinex/patchers",
        "config": "bepinex",
        "skip": "denikson-BepInExPack_Valheim"
      }
    }
  ],
  "configs": [
    {
      "path": "bepinex",
      "format": "bepinex",
      "name": {
        "ru": "Моды",
        "en": "Mods"
      }
    },
    {
      "path": "adminlist.txt",
      "format": "list",
      "name": {
        "ru": "Администраторы",
        "en": "Admins"
      },
      "description": {
        "ru": "Могут кикать и банить игроков и пользоваться консолью разработчика. ID игрока выглядит как Steam_76561198…, его видно в логе сервера и в игре по F2",
        "en": "Can kick and ban players and use the developer console. A player ID looks like Steam_76561198…, it shows in the server log and in game on F2"
      }
    },
    {
      "path": "bannedlist.txt",
      "format": "list",
      "name": {
        "ru": "Баны",
        "en": "Bans"
      },
      "description": {
        "ru": "Этим игрокам вход на сервер закрыт. ID игрока выглядит как Steam_76561198…, его видно в логе сервера и в игре по F2",
        "en": "These players cannot join the server. A player ID looks like Steam_76561198…, it shows in the server log and in game on F2"
      }
    },
    {
      "path": "permittedlist.txt",
      "format": "list",
      "name": {
        "ru": "Белый список",
        "en": "Whitelist"
      },
      "description": {
        "ru": "Если список не пуст, зайти смогут только эти игроки. ID игрока выглядит как Steam_76561198…, его видно в логе сервера и в игре по F2",
        "en": "When the list is not empty, only these players can join. A player ID looks like Steam_76561198…, it shows in the server log and in game on F2"
      }
    }
  ]
}
