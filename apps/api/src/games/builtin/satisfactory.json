{
  "id": "satisfactory",
  "name": "Satisfactory",
  "description": {
    "ru": "Выделенный сервер Satisfactory. При первом подключении игра попросит задать имя сервера и пароль администратора",
    "en": "Satisfactory dedicated server. On the first connection the game asks for a server name and an admin password"
  },
  "icon": "data:image/png;base64,",
  "image": "wolveix/satisfactory-server:latest",
  "dataPath": "/config",
  "ports": [
    {
      "name": "game",
      "container": 7777,
      "protocol": "udp"
    },
    {
      "name": "game-tcp",
      "container": 7777,
      "protocol": "tcp"
    },
    {
      "name": "messaging",
      "container": 8888,
      "protocol": "tcp"
    }
  ],
  "memory": {
    "default": 8192,
    "min": 4096
  },
  "env": {
    "MAXPLAYERS": "{{MAX_PLAYERS}}",
    "AUTOSAVENUM": "{{AUTOSAVES}}",
    "STEAMBETA": "{{BETA}}",
    "DISABLESEASONALEVENTS": "{{NO_EVENTS}}"
  },
  "stop": {
    "timeout": 120
  },
  "backup": {
    "exclude": [
      "gamefiles",
      "logs",
      "backups"
    ]
  },
  "variables": [
    {
      "key": "BETA",
      "step": "setup",
      "name": {
        "ru": "Ветка",
        "en": "Branch"
      },
      "type": "select",
      "default": "false",
      "options": [
        {
          "value": "false",
          "label": "Stable"
        },
        {
          "value": "true",
          "label": "Experimental"
        }
      ]
    },
    {
      "key": "MAX_PLAYERS",
      "name": {
        "ru": "Максимум игроков",
        "en": "Max players"
      },
      "type": "number",
      "default": "4",
      "pattern": "^([1-9]|[1-9][0-9])$",
      "description": {
        "ru": "Игра рассчитана на 4, больше — на свой страх и риск",
        "en": "The game is made for 4, more works at your own risk"
      }
    },
    {
      "key": "AUTOSAVES",
      "name": {
        "ru": "Автосохранений",
        "en": "Autosaves kept"
      },
      "type": "number",
      "default": "5",
      "pattern": "^([1-9]|[1-9][0-9])$",
      "description": {
        "ru": "Сколько последних автосохранений хранит игра",
        "en": "How many recent autosaves the game keeps"
      }
    },
    {
      "key": "NO_EVENTS",
      "name": {
        "ru": "Отключить сезонные события",
        "en": "Disable seasonal events"
      },
      "type": "boolean",
      "default": "false"
    }
  ]
}
