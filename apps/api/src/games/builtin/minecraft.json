{
  "id": "minecraft",
  "name": "Minecraft: Java Edition",
  "description": {
    "ru": "Vanilla, Paper, Purpur, Fabric, Quilt, Forge, NeoForge и модпаки с Modrinth и CurseForge",
    "en": "Vanilla, Paper, Purpur, Fabric, Quilt, Forge, NeoForge and modpacks from Modrinth and CurseForge"
  },
  "image": "itzg/minecraft-server:{{JAVA}}",
  "dataPath": "/data",
  "ports": [
    {
      "name": "game",
      "container": 25565,
      "protocol": "tcp"
    }
  ],
  "memory": {
    "default": 4096,
    "min": 1024
  },
  "env": {
    "EULA": "{{EULA}}",
    "TYPE": "{{TYPE}}{{PLATFORM}}",
    "VERSION": "{{VERSION}}",
    "MODRINTH_MODPACK": "{{MODRINTH_MODPACK}}",
    "MODRINTH_VERSION": "{{MODRINTH_VERSION}}",
    "CF_API_KEY": "{{HAKO_CURSEFORGE_API_KEY}}",
    "CF_SLUG": "{{CF_SLUG}}",
    "CF_FILE_ID": "{{CF_FILE_ID}}",
    "MEMORY": "{{SERVER_HEAP}}M",
    "TZ": "UTC",
    "STOP_DURATION": "180",
    "JVM_OPTS": "{{JVM_OPTS}}",
    "EXTRA_ARGS": "{{EXTRA_ARGS}}",
    "USE_SIMD_FLAGS": "{{SIMD}}",
    "ICON": "{{SERVER_ICON}}",
    "OVERRIDE_ICON": "TRUE",
    "MODRINTH_EXCLUDE_FILES": "{{MODPACK_EXCLUDE}}"
  },
  "console": {
    "ready": "Done \\(|Server started in",
    "version": "Starting minecraft server version (\\S+)",
    "players": {
      "join": "(?:: |\\] )([A-Za-z0-9_.]{1,16})(?:\\[[^\\]]*\\])?(?: joined the game| \\[\\/[^\\]]*\\] logged in with entity id)",
      "leave": "(?:: |\\] )([A-Za-z0-9_.]{1,16})(?: left the game| lost connection)"
    }
  },
  "stop": {
    "timeout": 210
  },
  "variables": [
    {
      "key": "KIND",
      "step": "setup",
      "name": {
        "ru": "Что запускаем",
        "en": "What to run"
      },
      "type": "select",
      "default": "core",
      "options": [
        {
          "value": "core",
          "label": {
            "ru": "Ядро",
            "en": "Server type"
          }
        },
        {
          "value": "modpack",
          "label": {
            "ru": "Модпак",
            "en": "Modpack"
          }
        },
        {
          "value": "custom",
          "label": {
            "ru": "Своё ядро",
            "en": "Custom jar"
          },
          "env": {
            "TYPE": "CUSTOM",
            "CUSTOM_SERVER": "/data/server.jar",
            "DISABLE_HEALTHCHECK": "true"
          }
        }
      ],
      "group": "version"
    },
    {
      "key": "TYPE",
      "step": "setup",
      "name": {
        "ru": "Ядро",
        "en": "Server type"
      },
      "type": "select",
      "default": "PAPER",
      "options": [
        {
          "value": "VANILLA",
          "label": "Vanilla",
          "description": {
            "ru": "Официальный сервер без модов",
            "en": "Official server, no mods"
          },
          "icon": "data:image/png;base64,"
        },
        {
          "value": "PAPER",
          "label": "Paper",
          "description": {
            "ru": "Быстрый сервер с плагинами",
            "en": "Fast server with plugins"
          },
          "icon": "data:image/svg+xml;base64,"
        },
        {
          "value": "PURPUR",
          "label": "Purpur",
          "description": {
            "ru": "Paper с дополнительными настройками",
            "en": "Paper with extra options"
          },
          "icon": "data:image/svg+xml;base64,"
        },
        {
          "value": "FABRIC",
          "label": "Fabric",
          "description": {
            "ru": "Лёгкие моды",
            "en": "Lightweight mods"
          },
          "icon": "data:image/svg+xml;base64,"
        },
        {
          "value": "QUILT",
          "label": "Quilt",
          "description": {
            "ru": "Моды Quilt и Fabric",
            "en": "Quilt and Fabric mods"
          },
          "icon": "data:image/svg+xml;base64,"
        },
        {
          "value": "FORGE",
          "label": "Forge",
          "description": {
            "ru": "Классические большие моды",
            "en": "Classic large mods"
          },
          "icon": "data:image/svg+xml;base64,"
        },
        {
          "value": "NEOFORGE",
          "label": "NeoForge",
          "description": {
            "ru": "Современная ветка Forge",
            "en": "The modern Forge fork"
          },
          "icon": "data:image/svg+xml;base64,"
        }
      ],
      "when": {
        "KIND": [
          "core"
        ]
      },
      "group": "version"
    },
    {
      "key": "PLATFORM",
      "step": "setup",
      "name": {
        "ru": "Площадка",
        "en": "Platform"
      },
      "type": "select",
      "default": "MODRINTH",
      "options": [
        {
          "value": "MODRINTH",
          "label": "Modrinth",
          "description": {
            "ru": "Модпаки с modrinth.com",
            "en": "Modpacks from modrinth.com"
          },
          "icon": "data:image/svg+xml;base64,"
        },
        {
          "value": "AUTO_CURSEFORGE",
          "label": "CurseForge",
          "description": {
            "ru": "Модпаки с curseforge.com",
            "en": "Modpacks from curseforge.com"
          },
          "icon": "data:image/svg+xml;base64,"
        },
        {
          "value": "MRPACK",
          "label": {
            "ru": "Свой .mrpack",
            "en": "Own .mrpack"
          },
          "description": {
            "ru": "Загрузите файл модпака с компьютера",
            "en": "Upload a modpack file from your computer"
          },
          "env": {
            "TYPE": "MODRINTH",
            "MODRINTH_MODPACK": "/data/modpack.mrpack"
          }
        }
      ],
      "when": {
        "KIND": [
          "modpack"
        ]
      },
      "group": "version"
    },
    {
      "key": "SNAPSHOTS",
      "step": "setup",
      "name": {
        "ru": "Снапшоты",
        "en": "Snapshots"
      },
      "type": "boolean",
      "default": "false",
      "when": {
        "KIND": [
          "core"
        ]
      },
      "group": "version"
    },
    {
      "key": "BETAS",
      "step": "setup",
      "name": {
        "ru": "Бета-версии",
        "en": "Beta versions"
      },
      "type": "boolean",
      "default": "false",
      "when": {
        "KIND": [
          "core"
        ]
      },
      "group": "version"
    },
    {
      "key": "VERSION",
      "step": "setup",
      "name": {
        "ru": "Версия Minecraft",
        "en": "Minecraft version"
      },
      "type": "select",
      "default": "LATEST",
      "required": true,
      "source": {
        "id": "minecraft-versions",
        "params": {
          "snapshots": "{{SNAPSHOTS}}",
          "betas": "{{BETAS}}"
        }
      },
      "when": {
        "KIND": [
          "core"
        ]
      },
      "group": "version"
    },
    {
      "key": "MODRINTH_MODPACK",
      "step": "setup",
      "name": {
        "ru": "Модпак",
        "en": "Modpack"
      },
      "type": "select",
      "required": true,
      "source": {
        "id": "modrinth-modpacks",
        "search": true
      },
      "when": {
        "KIND": [
          "modpack"
        ],
        "PLATFORM": [
          "MODRINTH"
        ]
      },
      "group": "version"
    },
    {
      "key": "MODRINTH_VERSION",
      "step": "setup",
      "name": {
        "ru": "Версия модпака",
        "en": "Modpack version"
      },
      "type": "select",
      "source": {
        "id": "modrinth-versions",
        "params": {
          "project": "{{MODRINTH_MODPACK}}"
        }
      },
      "when": {
        "KIND": [
          "modpack"
        ],
        "PLATFORM": [
          "MODRINTH"
        ]
      },
      "group": "version"
    },
    {
      "key": "CF_SLUG",
      "step": "setup",
      "name": {
        "ru": "Модпак",
        "en": "Modpack"
      },
      "type": "select",
      "required": true,
      "source": {
        "id": "curseforge-modpacks",
        "search": true
      },
      "when": {
        "KIND": [
          "modpack"
        ],
        "PLATFORM": [
          "AUTO_CURSEFORGE"
        ]
      },
      "group": "version"
    },
    {
      "key": "CF_FILE_ID",
      "step": "setup",
      "name": {
        "ru": "Версия модпака",
        "en": "Modpack version"
      },
      "type": "select",
      "source": {
        "id": "curseforge-files",
        "params": {
          "project": "{{CF_SLUG}}"
        }
      },
      "when": {
        "KIND": [
          "modpack"
        ],
        "PLATFORM": [
          "AUTO_CURSEFORGE"
        ]
      },
      "group": "version"
    },
    {
      "key": "MRPACK_FILE",
      "step": "setup",
      "group": "version",
      "name": {
        "ru": "Файл модпака",
        "en": "Modpack file"
      },
      "description": {
        "ru": "Файл .mrpack из Modrinth App или с сайта модпака",
        "en": "A .mrpack file from the Modrinth App or the modpack site"
      },
      "type": "file",
      "required": true,
      "file": {
        "accept": ".mrpack",
        "path": "modpack.mrpack"
      },
      "when": {
        "KIND": [
          "modpack"
        ],
        "PLATFORM": [
          "MRPACK"
        ]
      }
    },
    {
      "key": "CUSTOM_JAR",
      "step": "setup",
      "group": "version",
      "name": {
        "ru": "Файл ядра",
        "en": "Server jar"
      },
      "description": {
        "ru": "Исполняемый .jar сервера, он сохранится как server.jar в папке сервера",
        "en": "The server's runnable .jar, saved as server.jar in the server folder"
      },
      "type": "file",
      "required": true,
      "file": {
        "accept": ".jar",
        "path": "server.jar"
      },
      "when": {
        "KIND": [
          "custom"
        ]
      }
    },
    {
      "key": "MODPACK_EXCLUDE",
      "name": {
        "ru": "Не ставить на сервер",
        "en": "Skip on the server"
      },
      "description": {
        "ru": "Части имён файлов модпака через запятую, которые не нужно устанавливать: клиентские моды, которые ломают запуск сервера",
        "en": "Comma-separated parts of modpack file names to skip: client mods that break the server start"
      },
      "default": "missingmodschecker",
      "pattern": "^[\\w.+\\- ,]{0,500}$",
      "when": {
        "KIND": [
          "modpack"
        ],
        "PLATFORM": [
          "MODRINTH",
          "MRPACK"
        ]
      },
      "group": "startup"
    },
    {
      "key": "JAVA",
      "step": "setup",
      "name": "Java",
      "description": {
        "ru": "Minecraft до 1.17 нужна Java 8, до 1.20.4 — Java 17",
        "en": "Minecraft before 1.17 needs Java 8, before 1.20.5 Java 17"
      },
      "type": "select",
      "default": "latest",
      "options": [
        {
          "value": "latest",
          "label": {
            "ru": "Последняя",
            "en": "Latest"
          }
        },
        {
          "value": "java21",
          "label": "Java 21"
        },
        {
          "value": "java17",
          "label": "Java 17"
        },
        {
          "value": "java8",
          "label": "Java 8"
        }
      ],
      "group": "version"
    },
    {
      "key": "JVM_FLAGS",
      "name": {
        "ru": "Флаги запуска Java",
        "en": "Java startup flags"
      },
      "description": {
        "ru": "Готовые наборы флагов сборщика мусора, как на",
        "en": "Ready-made garbage collector flag sets, as on"
      },
      "link": {
        "url": "https://flags.sh",
        "text": "flags.sh"
      },
      "type": "select",
      "default": "aikar",
      "options": [
        {
          "value": "none",
          "label": {
            "ru": "Без флагов",
            "en": "None"
          },
          "description": {
            "ru": "Только настройки Java по умолчанию",
            "en": "Java defaults only"
          }
        },
        {
          "value": "aikar",
          "label": "Aikar",
          "description": {
            "ru": "Проверенный набор G1GC для большинства серверов",
            "en": "Proven G1GC set for most servers"
          },
          "env": {
            "USE_AIKAR_FLAGS": "true"
          }
        },
        {
          "value": "meowice",
          "label": "MeowIce",
          "description": {
            "ru": "Новее Aikar, для Java 17 и выше",
            "en": "Newer than Aikar, for Java 17 and later"
          },
          "env": {
            "USE_MEOWICE_FLAGS": "true"
          }
        }
      ],
      "preview": {
        "none": "",
        "aikar": "-XX:+UseG1GC -XX:+ParallelRefProcEnabled -XX:MaxGCPauseMillis=200 -XX:+UnlockExperimentalVMOptions -XX:+DisableExplicitGC -XX:+AlwaysPreTouch -XX:G1NewSizePercent=30 -XX:G1MaxNewSizePercent=40 -XX:G1HeapRegionSize=8M -XX:G1ReservePercent=20 -XX:G1HeapWastePercent=5 -XX:G1MixedGCCountTarget=4 -XX:InitiatingHeapOccupancyPercent=15 -XX:G1MixedGCLiveThresholdPercent=90 -XX:G1RSetUpdatingPauseTimePercent=5 -XX:SurvivorRatio=32 -XX:+PerfDisableSharedMem -XX:MaxTenuringThreshold=1 -Dusing.aikars.flags=https://mcflags.emc.gs -Daikars.new.flags=true",
        "meowice": "-XX:+UseG1GC -XX:+ParallelRefProcEnabled -XX:MaxGCPauseMillis=200 -XX:+UnlockExperimentalVMOptions -XX:+DisableExplicitGC -XX:+AlwaysPreTouch -XX:G1NewSizePercent=28 -XX:G1MaxNewSizePercent=50 -XX:G1HeapRegionSize=16M -XX:G1ReservePercent=15 -XX:G1HeapWastePercent=5 -XX:G1MixedGCCountTarget=3 -XX:InitiatingHeapOccupancyPercent=20 -XX:G1MixedGCLiveThresholdPercent=90 -XX:G1RSetUpdatingPauseTimePercent=0 -XX:SurvivorRatio=32 -XX:+PerfDisableSharedMem -XX:MaxTenuringThreshold=1 -XX:+UnlockDiagnosticVMOptions -XX:+UnlockExperimentalVMOptions -XX:+UseNUMA -XX:-DontCompileHugeMethods -XX:MaxNodeLimit=240000 -XX:NodeLimitFudgeFactor=8000 -XX:ReservedCodeCacheSize=400M -XX:NonNMethodCodeHeapSize=12M -XX:ProfiledCodeHeapSize=194M -XX:NonProfiledCodeHeapSize=194M -XX:NmethodSweepActivity=1 -XX:+UseFastUnorderedTimeStamps -XX:+UseCriticalJavaThreadPriority -XX:+AlwaysActAsServerClassMachine -XX:+UseTransparentHugePages -XX:LargePageSizeInBytes=2M -XX:+UseLargePages -XX:+EagerJVMCI -XX:+UseStringDeduplication -XX:+UseAES -XX:+UseAESIntrinsics -XX:+UseFMA -XX:+UseLoopPredicate -XX:+RangeCheckElimination -XX:+OptimizeStringConcat -XX:+UseCompressedOops -XX:+UseThreadPriorities -XX:+OmitStackTraceInFastThrow -XX:+RewriteBytecodes -XX:+RewriteFrequentPairs -XX:+UseFPUForSpilling -XX:+UseVectorCmov -XX:+UseXMMForArrayCopy -XX:+EliminateLocks -XX:+DoEscapeAnalysis -XX:+AlignVector -XX:+OptimizeFill -XX:+EnableVectorSupport -XX:+UseCharacterCompareIntrinsics -XX:+UseCopySignIntrinsic -XX:+UseVectorStubs -XX:G1SATBBufferEnqueueingThresholdPercent=30 -XX:G1ConcMarkStepDurationMillis=5 -XX:AllocatePrefetchStyle=3 -XX:+UseFastStosb -XX:+UseNewLongLShift -XX:+UseXmmI2D -XX:+UseXmmI2F -XX:+UseXmmLoadAndClearUpper -XX:+UseXmmRegToRegMoveAll -XX:UseAVX=2 -XX:UseSSE=4"
      },
      "group": "startup"
    },
    {
      "key": "SIMD",
      "name": {
        "ru": "Векторные инструкции (SIMD)",
        "en": "Vector instructions (SIMD)"
      },
      "description": {
        "ru": "Ускоряет Pufferfish и Purpur, остальным ядрам не нужно",
        "en": "Speeds up Pufferfish and Purpur, other server types do not use it"
      },
      "type": "boolean",
      "default": "false",
      "preview": {
        "true": "--add-modules=jdk.incubator.vector"
      },
      "group": "startup"
    },
    {
      "key": "JVM_OPTS",
      "name": {
        "ru": "Дополнительные флаги JVM",
        "en": "Extra JVM flags"
      },
      "description": {
        "ru": "Добавляются к строке запуска, например -Dfile.encoding=UTF-8",
        "en": "Appended to the startup line, for example -Dfile.encoding=UTF-8"
      },
      "group": "startup"
    },
    {
      "key": "EXTRA_ARGS",
      "name": {
        "ru": "Аргументы сервера",
        "en": "Server arguments"
      },
      "description": {
        "ru": "Передаются после server.jar, например --nogui",
        "en": "Passed after server.jar, for example --nogui"
      },
      "group": "startup"
    },
    {
      "key": "EULA",
      "name": {
        "ru": "Я принимаю",
        "en": "I agree to the"
      },
      "description": {
        "ru": "Чтобы запустить сервер Minecraft, нужно принять лицензионное соглашение Mojang.",
        "en": "You have to accept Mojang's End User License Agreement to run a Minecraft server."
      },
      "type": "boolean",
      "default": "false",
      "required": true,
      "group": "license",
      "link": {
        "url": "https://aka.ms/MinecraftEULA",
        "text": "Minecraft EULA"
      }
    }
  ],
  "addons": [
    {
      "source": "modrinth",
      "params": {
        "loader": "{{TYPE}}",
        "gameVersion": "{{VERSION}}"
      }
    }
  ],
  "configs": [
    {
      "path": "server.properties",
      "format": "properties",
      "name": {
        "ru": "Сервер",
        "en": "Server"
      },
      "fields": [
        {
          "key": "motd",
          "name": {
            "ru": "Описание в списке серверов",
            "en": "Server list message"
          },
          "default": "A Minecraft Server",
          "group": "general",
          "description": {
            "ru": "Две строки под названием сервера в списке серверов. Цвета и стили задаются кодами §",
            "en": "Two lines under the server name in the server list. Colours and styles use § codes"
          },
          "type": "motd"
        },
        {
          "key": "gamemode",
          "name": {
            "ru": "Режим игры",
            "en": "Game mode"
          },
          "type": "select",
          "options": [
            {
              "value": "survival",
              "label": {
                "ru": "Выживание",
                "en": "Survival"
              }
            },
            {
              "value": "creative",
              "label": {
                "ru": "Творческий",
                "en": "Creative"
              }
            },
            {
              "value": "adventure",
              "label": {
                "ru": "Приключение",
                "en": "Adventure"
              }
            },
            {
              "value": "spectator",
              "label": {
                "ru": "Наблюдатель",
                "en": "Spectator"
              }
            }
          ],
          "default": "survival",
          "group": "general",
          "description": {
            "ru": "Режим для новых игроков",
            "en": "Mode for new players"
          }
        },
        {
          "key": "difficulty",
          "name": {
            "ru": "Сложность",
            "en": "Difficulty"
          },
          "type": "select",
          "options": [
            {
              "value": "peaceful",
              "label": {
                "ru": "Мирная",
                "en": "Peaceful"
              }
            },
            {
              "value": "easy",
              "label": {
                "ru": "Лёгкая",
                "en": "Easy"
              }
            },
            {
              "value": "normal",
              "label": {
                "ru": "Нормальная",
                "en": "Normal"
              }
            },
            {
              "value": "hard",
              "label": {
                "ru": "Сложная",
                "en": "Hard"
              }
            }
          ],
          "default": "easy",
          "group": "general"
        },
        {
          "key": "hardcore",
          "name": {
            "ru": "Хардкор",
            "en": "Hardcore"
          },
          "type": "boolean",
          "default": "false",
          "group": "general",
          "description": {
            "ru": "Одна жизнь, после смерти — режим наблюдателя",
            "en": "One life, spectator mode after death"
          }
        },
        {
          "key": "max-players",
          "name": {
            "ru": "Максимум игроков",
            "en": "Max players"
          },
          "type": "number",
          "default": "20",
          "group": "players"
        },
        {
          "key": "online-mode",
          "name": {
            "ru": "Проверять лицензию игроков",
            "en": "Online mode"
          },
          "type": "boolean",
          "default": "true",
          "group": "players",
          "description": {
            "ru": "Пускать только игроков с лицензией",
            "en": "Only allow players with a paid account"
          }
        },
        {
          "key": "white-list",
          "name": {
            "ru": "Белый список",
            "en": "Whitelist"
          },
          "type": "boolean",
          "default": "false",
          "group": "players",
          "description": {
            "ru": "Пускать только игроков из белого списка",
            "en": "Only allow players on the whitelist"
          }
        },
        {
          "key": "enforce-whitelist",
          "name": {
            "ru": "Строгий белый список",
            "en": "Enforce whitelist"
          },
          "type": "boolean",
          "default": "false",
          "group": "players",
          "description": {
            "ru": "Выгонять игроков, которых убрали из белого списка",
            "en": "Kick players removed from the whitelist"
