{
  "id": "minecraft-bedrock",
  "name": "Minecraft: Bedrock Edition",
  "description": {
    "ru": "Официальный Bedrock Dedicated Server для Windows 10/11, консолей и телефонов",
    "en": "Official Bedrock Dedicated Server for Windows 10/11, consoles and phones"
  },
  "image": "itzg/minecraft-bedrock-server:latest",
  "dataPath": "/data",
  "ports": [
    {
      "name": "game",
      "container": 19132,
      "protocol": "udp"
    }
  ],
  "memory": {
    "default": 2048,
    "min": 512
  },
  "env": {
    "EULA": "{{EULA}}",
    "VERSION": "{{VERSION}}",
    "ALLOW_LIST": "{{ALLOW_LIST}}",
    "TZ": "UTC"
  },
  "console": {
    "ready": "Server started\\.",
    "version": "Version:? (\\d+(?:\\.\\d+)+)",
    "players": {
      "join": "Player connected: (.+?), xuid",
      "leave": "Player disconnected: (.+?), xuid"
    }
  },
  "stop": {
    "command": "stop",
    "timeout": 60
  },
  "backup": {
    "before": [
      "save hold"
    ],
    "after": [
      "save resume"
    ],
    "wait": 5
  },
  "players": {
    "name": "^[A-Za-z0-9][A-Za-z0-9 ]{0,15}$",
    "kick": "kick \"{{NAME}}\"",
    "lists": {
      "ops": {
        "add": "op \"{{NAME}}\"",
        "remove": "deop \"{{NAME}}\""
      },
      "whitelist": {
        "add": "allowlist add \"{{NAME}}\"",
        "remove": "allowlist remove \"{{NAME}}\""
      }
    }
  },
  "icon": "data:image/png;base64,",
  "variables": [
    {
      "key": "VERSION",
      "name": {
        "ru": "Версия",
        "en": "Version"
      },
      "type": "select",
      "default": "LATEST",
      "group": "version",
      "options": [
        {
          "value": "LATEST",
          "label": {
            "ru": "Последняя",
            "en": "Latest"
          }
        },
        {
          "value": "PREVIEW",
          "label": {
            "ru": "Preview",
            "en": "Preview"
          }
        }
      ],
      "description": {
        "ru": "Preview — тестовые сборки, к ним подключаются только клиенты Preview",
        "en": "Preview builds only accept Preview clients"
      },
      "step": "setup"
    },
    {
      "key": "ALLOW_LIST",
      "name": {
        "ru": "Белый список",
        "en": "Whitelist"
      },
      "description": {
        "ru": "Пускать только игроков из allowlist.json. Добавить игрока: allowlist add <ник> в консоли",
        "en": "Only let in players from allowlist.json. Add one with allowlist add <name> in the console"
      },
      "type": "boolean",
      "default": "false"
    },
    {
      "key": "EULA",
      "name": {
        "ru": "Я принимаю",
        "en": "I agree to the"
      },
      "description": {
        "ru": "Чтобы запустить сервер Minecraft, нужно принять лицензионное соглашение Mojang.",
        "en": "You have to accept Mojang's End User License Agreement to run a Minecraft server."
      },
      "type": "boolean",
      "default": "false",
      "required": true,
      "group": "license",
      "link": {
        "url": "https://aka.ms/MinecraftEULA",
        "text": "Minecraft EULA"
      }
    }
  ],
  "groups": [
    {
      "id": "version",
      "name": {
        "ru": "Версия",
        "en": "Version"
      },
      "description": {
        "ru": "Версия Bedrock-сервера",
        "en": "Bedrock server version"
      }
    },
    {
      "id": "license",
      "name": {
        "ru": "Лицензия",
        "en": "License"
      }
    }
  ],
  "configs": [
    {
      "path": "server.properties",
      "format": "properties",
      "name": {
        "ru": "Сервер",
        "en": "Server"
      },
      "defaults": "server-name=Dedicated Server\ngamemode=survival\nforce-gamemode=false\ndifficulty=easy\nallow-cheats=false\nmax-players=10\nonline-mode=true\nallow-list=false\nserver-port=19132\nserver-portv6=19133\nenable-lan-visibility=true\nview-distance=32\ntick-distance=4\nplayer-idle-timeout=30\nmax-threads=8\nlevel-name=Bedrock level\nlevel-seed=\ndefault-player-permission-level=member\ntexturepack-required=false\ncontent-log-file-enabled=false\ncompression-threshold=1\nchat-restriction=None\ndisable-player-interaction=false\n",
      "groups": [
        {
          "id": "general",
          "name": {
            "ru": "Основное",
            "en": "General"
          },
          "description": {
            "ru": "Как сервер выглядит в списке и как в нём играют",
            "en": "How the server looks in the list and how it plays"
          }
        },
        {
          "id": "players",
          "name": {
            "ru": "Игроки и доступ",
            "en": "Players and access"
          },
          "description": {
            "ru": "Кто может зайти и что им разрешено",
            "en": "Who can join and what they are allowed to do"
          }
        },
        {
          "id": "world",
          "name": {
            "ru": "Мир",
            "en": "World"
          },
          "description": {
            "ru": "Генерация, мобы и измерения",
            "en": "Generation, mobs and dimensions"
          }
        },
        {
          "id": "performance",
          "name": {
            "ru": "Производительность",
            "en": "Performance"
          },
          "description": {
            "ru": "Чем меньше дальность, тем легче серверу",
            "en": "Lower distances make the server lighter"
          }
        }
      ],
      "fields": [
        {
          "key": "server-name",
          "name": {
            "ru": "Название сервера",
            "en": "Server name"
          },
          "type": "string",
          "default": "Dedicated Server",
          "group": "general",
          "description": {
            "ru": "Показывается в списке серверов и в LAN",
            "en": "Shown in the server list and on LAN"
          }
        },
        {
          "key": "gamemode",
          "name": {
            "ru": "Режим игры",
            "en": "Game mode"
          },
          "type": "select",
          "default": "survival",
          "group": "general",
          "options": [
            {
              "value": "survival",
              "label": {
                "ru": "Выживание",
                "en": "Survival"
              }
            },
            {
              "value": "creative",
              "label": {
                "ru": "Творческий",
                "en": "Creative"
              }
            },
            {
              "value": "adventure",
              "label": {
                "ru": "Приключение",
                "en": "Adventure"
              }
            }
          ]
        },
        {
          "key": "force-gamemode",
          "name": {
            "ru": "Принудительный режим",
            "en": "Force game mode"
          },
          "type": "boolean",
          "default": "false",
          "group": "general",
          "description": {
            "ru": "Возвращать игроков в режим сервера при входе",
            "en": "Put players back into the server mode when they join"
          }
        },
        {
          "key": "difficulty",
          "name": {
            "ru": "Сложность",
            "en": "Difficulty"
          },
          "type": "select",
          "default": "easy",
          "group": "general",
          "options": [
            {
              "value": "peaceful",
              "label": {
                "ru": "Мирная",
                "en": "Peaceful"
              }
            },
            {
              "value": "easy",
              "label": {
                "ru": "Лёгкая",
                "en": "Easy"
              }
            },
            {
              "value": "normal",
              "label": {
                "ru": "Нормальная",
                "en": "Normal"
              }
            },
            {
              "value": "hard",
              "label": {
                "ru": "Сложная",
                "en": "Hard"
              }
            }
          ]
        },
        {
          "key": "allow-cheats",
          "name": {
            "ru": "Читы",
            "en": "Cheats"
          },
          "type": "boolean",
          "default": "false",
          "group": "general",
          "description": {
            "ru": "Разрешить команды вроде /give и /gamemode",
            "en": "Allow commands such as /give and /gamemode"
          }
        },
        {
          "key": "enable-lan-visibility",
          "name": {
            "ru": "Виден в LAN",
            "en": "Visible on LAN"
          },
          "type": "boolean",
          "default": "true",
          "group": "general"
        },
        {
          "key": "max-players",
          "name": {
            "ru": "Максимум игроков",
            "en": "Max players"
          },
          "type": "number",
          "default": "10",
          "group": "players"
        },
        {
          "key": "online-mode",
          "name": {
            "ru": "Вход через Xbox",
            "en": "Xbox sign-in"
          },
          "type": "boolean",
          "default": "true",
          "group": "players",
          "description": {
            "ru": "Требовать аккаунт Microsoft у всех игроков",
            "en": "Require a Microsoft account from every player"
          }
        },
        {
          "key": "default-player-permission-level",
          "name": {
            "ru": "Права новых игроков",
            "en": "New player permissions"
          },
          "type": "select",
          "default": "member",
          "group": "players",
          "options": [
            {
              "value": "visitor",
              "label": {
                "ru": "Посетитель",
                "en": "Visitor"
              }
            },
            {
              "value": "member",
              "label": {
                "ru": "Участник",
                "en": "Member"
              }
            },
            {
              "value": "operator",
              "label": {
                "ru": "Оператор",
                "en": "Operator"
              }
            }
          ]
        },
        {
          "key": "player-idle-timeout",
          "name": {
            "ru": "Кик за бездействие, мин",
            "en": "Idle kick, min"
          },
          "type": "number",
          "default": "30",
          "group": "players",
          "description": {
            "ru": "0 — не кикать",
            "en": "0 turns it off"
          }
        },
        {
          "key": "chat-restriction",
          "name": {
            "ru": "Ограничение чата",
            "en": "Chat restriction"
          },
          "type": "select",
          "default": "None",
          "group": "players",
          "options": [
            {
              "value": "None",
              "label": {
                "ru": "Нет",
                "en": "None"
              }
            },
            {
              "value": "Dropped",
              "label": {
                "ru": "Скрывать",
                "en": "Dropped"
              }
            },
            {
              "value": "Disabled",
              "label": {
                "ru": "Отключён",
                "en": "Disabled"
              }
            }
          ]
        },
        {
          "key": "texturepack-required",
          "name": {
            "ru": "Обязательные паки мира",
            "en": "Required world packs"
          },
          "type": "boolean",
          "default": "false",
          "group": "players",
          "description": {
            "ru": "Игроки должны скачать ресурс-паки мира",
            "en": "Players must download the world resource packs"
          }
        },
        {
          "key": "level-name",
          "name": {
            "ru": "Название мира",
            "en": "World name"
          },
          "type": "string",
          "default": "Bedrock level",
          "group": "world",
          "description": {
            "ru": "Папка мира в worlds/",
            "en": "World folder inside worlds/"
          }
        },
        {
          "key": "level-seed",
          "name": {
            "ru": "Сид",
            "en": "Seed"
          },
          "type": "string",
          "default": "",
          "group": "world",
          "description": {
            "ru": "Применяется только к новому миру",
            "en": "Only used for a new world"
          }
        },
        {
          "key": "view-distance",
          "name": {
            "ru": "Дальность прорисовки",
            "en": "View distance"
          },
          "type": "number",
          "default": "32",
          "group": "performance",
          "description": {
            "ru": "В чанках, минимум 5",
            "en": "In chunks, at least 5"
          }
        },
        {
          "key": "tick-distance",
          "name": {
            "ru": "Дальность симуляции",
            "en": "Simulation distance"
          },
          "type": "number",
          "default": "4",
          "group": "performance",
          "description": {
            "ru": "От 4 до 12 чанков",
            "en": "4 to 12 chunks"
          }
        },
        {
          "key": "max-threads",
          "name": {
            "ru": "Потоки",
            "en": "Threads"
          },
          "type": "number",
          "default": "8",
          "group": "performance",
          "description": {
            "ru": "0 — столько, сколько сможет сервер",
            "en": "0 lets the server use as many as it can"
          }
        }
      ]
    }
  ]
}
