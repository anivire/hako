{
  "name": "api",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "dev": "node --watch --watch-preserve-output --env-file-if-exists=../../.env --import tsx src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@hako/shared": "*",
    "@hono/node-server": "^2.1.8",
    "better-sqlite3": "^12.11.1",
    "dockerode": "^4.0.9",
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.3",
    "hono": "^4.13.18",
    "ssh2": "^1.17.0",
    "tar": "^7.5.23",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/dockerode": "^3.3.47",
    "@types/node": "^26.6.6",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15"
  }
}
